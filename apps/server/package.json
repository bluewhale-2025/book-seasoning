{
  "name": "@bookseasoning/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "eval:ai:live": "node --env-file-if-exists=../../.env --import tsx src/evals/s5-provider.live-eval.ts",
    "eval:results:live": "node --env-file-if-exists=../../.env --import tsx src/evals/s6-results.live-eval.ts",
    "eval:builder:live": "node --env-file-if-exists=../../.env --import tsx src/evals/s7-builder.live-eval.ts",
    "smoke:account-deletion": "node --env-file-if-exists=../../.env --import tsx scripts/account-deletion.local-smoke.ts",
    "smoke:account-deletion-recovery": "node --env-file-if-exists=../../.env --import tsx scripts/account-deletion-recovery.local-smoke.ts",
    "pretest": "pnpm --filter @bookseasoning/contracts build && pnpm --filter @bookseasoning/domain build",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@bookseasoning/contracts": "workspace:*",
    "@bookseasoning/domain": "workspace:*",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@supabase/supabase-js": "2.112.4",
    "argon2": "0.45.1",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "kysely": "0.29.5",
    "openai": "7.8.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
