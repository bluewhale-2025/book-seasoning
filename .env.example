NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info
RELEASE_VERSION=local
CORS_ORIGINS=http://localhost:5173

# Configure both values together when Supabase-backed modules are enabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# API/worker server-only. Never expose this value to apps/web.
SUPABASE_SECRET_KEY=

# Worker-only direct Postgres or Supavisor session-pooler URL.
# Local example: postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=

# Worker-only OpenAI Responses API configuration. Do not expose the key to web.
# `pnpm eval:ai:live`, `pnpm eval:results:live`, and
# `pnpm eval:builder:live` read these values from the repository-root .env.
OPENAI_API_KEY=
OPENAI_EVALUATOR_MODEL=gpt-5.6-luna
OPENAI_HOST_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=20000

# Server-only HMAC key (at least 32 characters) for command payload fingerprints.
COMMAND_FINGERPRINT_KEY=

# Browser-public deployment inventory. For local Vite, copy apps/web/.env.example
# to apps/web/.env.local. Never use SUPABASE_SECRET_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:3000
# Browser-public Cloudflare Turnstile site key. Leave empty for local CAPTCHA-off development.
VITE_TURNSTILE_SITE_KEY=
